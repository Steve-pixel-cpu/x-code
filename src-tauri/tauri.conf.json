{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "x-code",
  "version": "3.3.2",
  "identifier": "com.xcode.desktop",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "resources": {
      "server/x-code-server.exe": "resources/server/x-code-server.exe",
      "pets": "pets",
      "WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxNUU0MjE2MEY2NDVBNDgKUldSSVdtUVBGa0plZ2NQNjJPQlNlWXlWMlFQdW02citKWU5OblR2cWcrZ1JOQ2V1cW8vLzFBQnoK",
      "endpoints": [
        "https://github.com/Steve-pixel-cpu/x-code/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

