{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "windows": ["main", "pet"],
  "remote": {
    "urls": ["http://127.0.0.1", "http://127.0.0.1:*", "http://localhost", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "allow-pick-folder",
    "allow-read-clipboard-text",
    "allow-notify-desktop",
    "allow-check-update",
    "allow-install-update",
    "allow-update-status",
    "allow-minimize-main",
    "allow-toggle-maximize-main",
    "allow-close-main",
    "allow-start-drag-main",
    "allow-open-pet-window",
    "allow-close-pet",
    "allow-start-drag-pet",
    "allow-set-pet-click-through",
    "allow-move-pet-window",
    "allow-resize-pet-window",
    "clipboard-manager:allow-read-text"
  ]
}
