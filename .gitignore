# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.

.idea/
.zcode/
__pycache__/
.env
prompt_dev
docs

# Electron / Node
node_modules/
dist/
build/
src-tauri/target
src-tauri/Debug


# Rust / Tauri build artifacts
src-tauri/gen/
cargo-*.log


# 日志与临时产物（统一收口, 覆盖 tauri/uvicorn/cargo 各命名）
*.log

# 测试缓存与临时存储
.pytest_cache/
test_storage/

# 打包中间产物: 由 build-exe.cmd 从 build/server/ 复制, 不入库
src-tauri/server/

# 宠物资产打包中间产物: 由 build-exe.cmd 从 pets/ 复制(仓库根 pets/ 是源)
src-tauri/pets/

# 更新签名私钥: 绝不入库。丢了老用户就收不到自动更新, 保管好
.tauri/
